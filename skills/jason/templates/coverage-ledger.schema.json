{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM App Security coverage ledger",
  "description": "Cross-checks against findings.json (fingerprints, status evidence, unique ids) are enforced by scripts/validate-findings.cjs --ledger.",
  "type": "object",
  "required": ["schema_version", "units"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "paths", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["entry-point", "data-store", "auth", "llm-feature", "config", "dependency", "other"] },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["pending", "candidate", "covered", "partial", "deferred", "out_of_scope", "not_applicable"] },
          "prior_status": { "enum": ["new", "carried", "changed", "prior_open"] },
          "classes_checked": { "type": "array", "items": { "type": "string" } },
          "fingerprints": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
